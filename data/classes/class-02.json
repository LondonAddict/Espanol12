        { "speaker": "Vendedor", "es": "Cinco euros. ¿Tarjeta o efectivo?" },
        { "speaker": "Tú", "es": "Tarjeta." },
        { "speaker": "Vendedor", "es": "Vale. Gracias, adiós." },
        { "speaker": "Tú", "es": "Hasta luego." }
      ]
    }
