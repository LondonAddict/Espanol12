  "dialogues": [
    {
      "title": "Un día en Barcelona",
      "turns": [
        { "speaker": "Amigo 1", "role": "customer", "es": "Quería ir a un restaurante de tapas. ¿Vamos?" },
        { "speaker": "Amigo 2", "role": "staff", "es": "Sí, me gusta el restaurante de tapas. ¡Vamos!" },
        { "speaker": "Amigo 2", "role": "staff", "es": "Quería ir a un hotel en la playa. ¿Vamos?" },
        { "speaker": "Amigo 1", "role": "customer", "es": "No, no me gusta el hotel en la playa. Quería ir a un hotel en la montaña." },
        { "speaker": "Amigo 2", "role": "staff", "es": "Vale. Vamos a un hotel en la montaña." },
        { "speaker": "Amigo 1", "role": "customer", "es": "Quería hacer senderismo. ¿Vamos?" },
        { "speaker": "Amigo 2", "role": "staff", "es": "No, no me gusta hacer senderismo. Quería ir de compras." },
        { "speaker": "Amigo 1", "role": "customer", "es": "Vale. Vamos de compras." },
        { "speaker": "Amigo 2", "role": "staff", "es": "¡Qué bien!" }
      ]
    }
  ],
  "speakingPractice": {
    "scenario": "You are a friendly local friend planning a day out in Barcelona with the student: a restaurant, a hotel, and an activity. Take turns suggesting each one with 'Quería ir a…' or 'Quería hacer…' plus '¿Vamos?', and react honestly to what they suggest.",
    "goalOrder": [
      "Start by suggesting a restaurant (de tapas, italiano, or de carne) using 'Quería ir a un restaurante…' + '¿Vamos?'",
      "When the student suggests something, react honestly: if you like it, say 'Sí, me gusta… ¡Vamos!'; if not, say 'No, no me gusta… Quería ir a…' with a different option, and wait for them to say 'Vale.' before moving on",
      "Once the restaurant is agreed, suggest a hotel (en la playa, en el centro, or en la montaña) the same way",
      "Once the hotel is agreed, suggest an activity (hacer senderismo, observar aves, or ir de compras - or one of the other taught activities) the same way",
      "Somewhere along the way, ask the student directly '¿Te gusta…?' about one of the taught activities or things (e.g. el golf, el cine, leer, la jardinería) and react warmly - '¡Qué bien!' if they say yes",
      "Once the restaurant, hotel, and activity are all agreed, close warmly - 'Vale, ¡vamos!' and say goodbye"
    ],
    "openingLine": "¡Hola! Quería ir a un restaurante de tapas. ¿Vamos?"
  }
}
