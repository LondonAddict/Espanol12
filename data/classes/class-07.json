    { "question": "How do you say 'I like walking' (me gusta + an action)?", "choices": ["Me gusta caminar.", "Me gustan caminar.", "Me gusta el caminar.", "Te gusta caminar."], "answer": "Me gusta caminar." },
    { "question": "How do you say 'I like the beach' (me gusta + one thing)?", "choices": ["Me gusta la playa.", "Me gustan la playa.", "Te gusta la playa.", "Me gusta las playas."], "answer": "Me gusta la playa." },
