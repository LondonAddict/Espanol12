# Which AI provider to use for the Speaking Practice feature.
# Currently only "anthropic" is implemented. See README "Open Questions"
# for the discussion Viktoria needs to weigh in on before this is final.
AI_PROVIDER=anthropic

# Anthropic API key (https://console.anthropic.com/). Required for the
# /api/chat endpoint that powers AI Speaking Practice. Never expose this
# key to the browser - it is only read server-side.
ANTHROPIC_API_KEY=

# Model used for speaking practice replies. Defaults to a fast, low-cost
# model since each turn only needs to pick from a short closed phrase list.
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Port the Express server listens on (Railway sets this automatically).
PORT=3000
